* text=auto

# Windows-скрипты должны оставаться с CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Unix-скрипты должны оставаться с LF, иначе на macOS ломается shebang
*.sh text eol=lf
*.command text eol=lf
*.pl text eol=lf
macos/tests/stubs/* text eol=lf

# Бинарники не трогаем
*.exe binary
*.dll binary
*.sys binary
*.bin binary
*.ico binary
*.lnk binary
*.pyc binary
